# Node 24+: npm start (loads .env when present). No actual credentials in this file.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DAY_SECONDS=60
MAX_ROOMS=20
ALLOW_TEST_BOTS=true
VOICE_PROXIMITY_RANGE=10
WORLD_UNITS_PER_METER=24
# Local durable storage. A persistent disk/volume is necessary in production.
STATE_DIR=./var/rooms
# Comma-separated exact web origins. Set your actual HTTPS origin in production.
# ALLOWED_ORIGINS=https://your-game.example
STUN_URLS=stun:stun.l.google.com:19302
# coturn shared-secret authentication; generate a secret privately, never commit it.
# TURN_URLS=turn:your-turn.example:3478?transport=udp,turns:your-turn.example:5349?transport=tcp
# TURN_SECRET=
# VOICE_RELAY_ONLY=true hides peer IPs from one another but requires working TURN.
VOICE_RELAY_ONLY=false
