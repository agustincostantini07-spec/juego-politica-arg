# Copy to a private server config. Substitute YOUR_PUBLIC_IP / YOUR_TURN_DOMAIN.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
# static-auth-secret must match TURN_SECRET in the game server environment.
# Supply the actual value privately to coturn; never commit the populated config.
# static-auth-secret=
realm=YOUR_TURN_DOMAIN
external-ip=YOUR_PUBLIC_IP
min-port=49160
max-port=49200
# Supply certificate and key files for TURN/TLS.
# cert=/etc/letsencrypt/live/YOUR_TURN_DOMAIN/fullchain.pem
# pkey=/etc/letsencrypt/live/YOUR_TURN_DOMAIN/privkey.pem
no-cli
no-multicast-peers
# Loopback peers remain disabled by default; do not enable allow-loopback-peers.
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
user-quota=12
total-quota=240
stale-nonce=600
